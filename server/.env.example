# -----------------------------------------------------------------------
# TEMPLATE ONLY - THIS FILE IS COMMITTED TO THE PUBLIC GITHUB REPO.
#
# Never put a real value in this file. Copy it to `.env` (which .gitignore
# excludes) and put the real values there instead:
#
#   cd server
#   cp .env.example .env
#
# If a real key ever lands in here, do not just delete it and commit -
# rotate the key in Supabase first, because anything pushed to GitHub is
# permanently in the repo's history.
# -----------------------------------------------------------------------

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign our own JWTs (not Supabase's). Generate a long
# random string, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port Express listens on locally (Railway sets its own PORT in prod)
PORT=4000

# Deployed frontend URL, used to restrict CORS in production.
# Use http://localhost:5173 locally, https://eeroom.io once deployed.
CLIENT_URL=http://localhost:5173
