

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to sign our own JWTs (not Supabase's). Generate a long
# random string, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port Express listens on locally (Railway sets its own PORT in prod)
PORT=4000

# Deployed frontend URL, used to restrict CORS in production
CLIENT_URL=https://eeroom.io
